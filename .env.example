DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
CHANNEL_ID=

# IANA timezone. Week bounds, cron, and check-in dates all use this.
TZ=Australia/Sydney

# Local default. On Railway use /data/finesse.sqlite and mount a volume at /data.
DATABASE_PATH=./data/finesse.sqlite

# Default weekly target for new members. /setup target: can override per person.
WEEKLY_TARGET=3

# HTTP port for /health and OAuth callbacks. Railway sets PORT.
PORT=3000

# Public https origin of this process (no trailing slash). Required for OAuth
# and Intervals webhooks. Laptop localhost cannot receive Garmin pings.
# PUBLIC_URL=https://your-app.up.railway.app

# LLM. gemini | none. Defaults to gemini when GEMINI_API_KEY is set, else none.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Intervals.icu
# Without the OAuth app: /connect pastes a personal API key; we poll every 15 minutes.
# With OAuth (needed for webhooks): apply at https://intervals.icu/oauth/apply
# then Manage App → webhook URL {PUBLIC_URL}/webhooks/intervals
#   INTERVALS_CLIENT_ID=
#   INTERVALS_CLIENT_SECRET=
#   INTERVALS_WEBHOOK_SECRET=
# Redirect URI: {PUBLIC_URL}/oauth/intervals/callback
# Scope: ACTIVITY:READ
# Events: ACTIVITY_UPLOADED, ACTIVITY_ANALYZED
# Strava-originated activities never send webhooks; the daily pull still gets them.

# Strava (optional). Create an API app at https://www.strava.com/settings/api
# Callback domain must match PUBLIC_URL. Authorization callback:
#   {PUBLIC_URL}/oauth/strava/callback
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Lookback used for every activity source (Intervals + Strava).
# STRAVA_LOOKBACK_HOURS=36
